{
  "name": "dsh-client-ui-solarized-grid",
  "version": "1.0.0",
  "description": "Solarized Light palette (plus Solarized Dark) and a notebook grid background for the DSH Web client, with a styled user-message bubble",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "solarized",
    "notebook",
    "grid"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CREDITS.md",
    "CHANGELOG.md",
    "install.ps1",
    "uninstall.ps1",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EYEjunnnn/dsh-client-ui-solarized-grid.git"
  },
  "bugs": {
    "url": "https://github.com/EYEjunnnn/dsh-client-ui-solarized-grid/issues"
  },
  "homepage": "https://github.com/EYEjunnnn/dsh-client-ui-solarized-grid#readme",
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
